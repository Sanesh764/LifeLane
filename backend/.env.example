# =================================================================
# AmbuRoute Backend Environment Configuration Template
# Conforms to Render Web Service & AWS Amplify production deployment
# =================================================================

# 1. Server & Environment
# Render automatically injects PORT at runtime.
PORT=5000
NODE_ENV=production

# 2. CORS Allowed Origins (Comma-separated list or single URL)
# For production, set to your exact AWS Amplify frontend domain:
CORS_ORIGIN=https://main.d37a0y0p7v19sh.amplifyapp.com,http://localhost:5173

# 3. Database (MongoDB Atlas)
# In MongoDB Atlas, ensure Network Access allows 0.0.0.0/0 (Render dynamic IPs)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/amburoute?retryWrites=true&w=majority

# 4. Authentication & Security
# Generate with: openssl rand -base64 32
JWT_SECRET=your_secure_jwt_secret_at_least_32_characters_long
JWT_EXPIRES_IN=3600

# 5. Web Push Notification & VAPID Configuration
# Stable VAPID keys required (do not leave empty in production)
VAPID_PUBLIC_KEY=your_vapid_base64url_public_key
VAPID_PRIVATE_KEY=your_vapid_base64url_private_key
VAPID_SUBJECT=mailto:emergency-ops@amburoute.org

# Emergency Notification Delivery Mode:
# 'GLOBAL' for all-device broadcast in hackathon/demo; 'PROXIMITY' for strict geospatial radius
EMERGENCY_NOTIFICATION_MODE=GLOBAL
NOTIFICATION_DEMO_BROADCAST_ALL=true

# 6. AI Voice Assistant & Transcription (Groq Whisper & Llama)
GROQ_API_KEY=your_groq_api_key_gsk_xxx
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_CHAT_MODEL=openai/gpt-oss-20b

# 7. Meta AI Model Configuration (Traffic Intelligence)
COMET_API_KEY=your_comet_or_meta_api_key_here
META_MODEL=muse-spark-1.3
META_API_BASE_URL=https://api.meta.ai/v1

# 8. Proximity Alert Engine Settings
ALERT_OUTER_RADIUS_METERS=5000
ALERT_NEAR_RADIUS_METERS=2000
ALERT_REFRESH_INTERVAL_SECONDS=25
ALERT_REPEAT_COOLDOWN_SECONDS=20
ROAD_USER_LOCATION_MAX_AGE_SECONDS=90
ROAD_USER_MAX_LOCATION_ACCURACY_METERS=200

# 9. Initial Authorized Driver Provisioning (scripts/seedDriver.js)
INITIAL_DRIVER_EMAIL=driver@amburoute.demo
INITIAL_DRIVER_PASSWORD=your_secure_initial_driver_password
INITIAL_DRIVER_NAME=Amitabh Sen
INITIAL_DRIVER_CALLSIGN=Patna Unit 108 — Alpha
INITIAL_DRIVER_VEHICLE=BR-01-EA-108
INITIAL_DRIVER_HOSPITAL=PMCH Emergency Trauma Center

# 10. Google OAuth Configuration (Public Users Only)
GOOGLE_CLIENT_ID=your_google_client_id_apps_googleusercontent_com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://amburoute-backend-gb2v.onrender.com/api/auth/google/callback
