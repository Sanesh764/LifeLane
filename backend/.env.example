PORT=5000
MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=your_secure_jwt_secret_at_least_32_characters
JWT_EXPIRES_IN=3600
CORS_ORIGIN=http://localhost:5173
GROQ_API_KEY=your_groq_api_key

# Initial Authorized Driver Provisioning (scripts/seedDriver.js)
INITIAL_DRIVER_EMAIL=driver@amburoute.demo
INITIAL_DRIVER_PASSWORD=your_secure_initial_driver_password
INITIAL_DRIVER_NAME=Amitabh Sen
INITIAL_DRIVER_CALLSIGN=Patna Unit 108 — Alpha
INITIAL_DRIVER_VEHICLE=BR-01-EA-108
INITIAL_DRIVER_HOSPITAL=PMCH Emergency Trauma Center

# Web Push Notification & VAPID Configuration
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:emergency-ops@amburoute.org

# Proximity Alert Engine Settings
ALERT_OUTER_RADIUS_METERS=5000
ALERT_NEAR_RADIUS_METERS=2000
ALERT_REFRESH_INTERVAL_SECONDS=25
ALERT_REPEAT_COOLDOWN_SECONDS=20
ROAD_USER_LOCATION_MAX_AGE_SECONDS=90
ROAD_USER_MAX_LOCATION_ACCURACY_METERS=200

# Meta Model API Configuration (Traffic Intelligence)
COMET_API_KEY=your_meta_api_key_here
META_MODEL=muse-spark-1.3
META_API_BASE_URL=https://api.meta.ai/v1

# Emergency Notification Delivery Mode (GLOBAL for all-device broadcast in hackathon/demo; PROXIMITY for geospatial)
EMERGENCY_NOTIFICATION_MODE=GLOBAL
